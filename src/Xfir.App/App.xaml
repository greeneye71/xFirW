<Application x:Class="Xfir.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Startup="OnStartup">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#2359AD" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="17,9" /><Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#18324F" />
      <Setter Property="BorderBrush" Value="#CDD7E3" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="13" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.8" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.38" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#2359AD" /><Setter TargetName="Body" Property="BorderThickness" Value="2" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#68798E" /><Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,18,0,5" />
    </Style>
    <Style x:Key="Detail" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#172C46" /><Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="18,10" /><Setter Property="FontSize" Value="13" /></Style>
  </Application.Resources>
</Application>
